# Django
SECRET_KEY=change-me
DEBUG=True
RUNSERVER_SERVE_STATIC=True
DOMAIN=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
USE_SQLITE=True
USE_LOCAL_CACHE=True

# PostgreSQL, used when USE_SQLITE=False
DB_NAME=mytools
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis, used when USE_LOCAL_CACHE=False
REDIS_URL=redis://redis:6379/0

# Email
EMAIL_BACKEND_MODE=console
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=MyTools <noreply@localhost>
SERVER_EMAIL=MyTools <noreply@localhost>

# External APIs
OPENWEATHER_API_KEY=
TANKERKOENIG_API_KEY=
GENIUS_API_KEY=

# Spotify PKCE browser integration
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=

# Voicemod local integration
VOICEMOD_API_KEY=
VOICEMOD_HOST=127.0.0.1
VOICEMOD_PORTS=59129,20000,39273,42152,43782,46667,35679,37170,38501,33952,30546

# reCAPTCHA
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=

# Analytics and icons
GOOGLE_ANALYTICS_ID=
FONTAWESOME_KIT_KEY=
USE_FONTAWESOME_KIT=False

# Security headers
CSP_REPORT_ONLY=True
CSP_POLICY=

# Optional Cloudflare tunnel container
CLOUDFLARE_TUNNEL_TOKEN=
