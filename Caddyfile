(mytools_static) {
    encode gzip zstd

    request_body {
        max_size 110MB
    }

    handle_path /static/* {
        root * /app/staticfiles
        header {
            Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
            Vary "Accept-Encoding"
            X-Content-Type-Options "nosniff"
        }
        file_server
    }

    @public_media {
        path /media/public/* /media/profile_pictures/* /media/profile_banners/* /media/shortcut_icons/* /media/avatar_characters/*
    }

    @active_public_media path_regexp active_media (?i)^/media/(public|profile_pictures|profile_banners|shortcut_icons|avatar_characters)/.*\.(svgz?|xhtml?|html?|mhtml?|xml)$

    handle @active_public_media {
        root * /app
        header {
            Cache-Control "private, no-store"
            Content-Disposition "attachment"
            Content-Type "application/octet-stream"
            Content-Security-Policy "default-src 'none'; sandbox"
            X-Content-Type-Options "nosniff"
        }
        file_server
    }

    handle @public_media {
        root * /app
        header {
            Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
            Content-Security-Policy "default-src 'none'; sandbox"
            Vary "Accept-Encoding"
            X-Content-Type-Options "nosniff"
        }
        file_server
    }

    header {
        Permissions-Policy "geolocation=(self), microphone=(), camera=()"
    }

    log {
        output stdout
        format console
    }
}

http://{$DOMAIN:localhost} {
    import mytools_static

    handle {
        reverse_proxy web:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host {host}
        }
    }
}

:80 {
    import mytools_static

    handle {
        reverse_proxy web:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }
}
